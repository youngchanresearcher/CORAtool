## When the article describing this R package appears, replace the Manual
## entry below with its bibentry (bibtype = "Article", with journal, volume,
## pages and doi) and bump the year. Keep the method entry: anyone reporting
## a CORA analysis has to cite the method, whichever software produced it.

citHeader(paste("To cite CORA in publications, cite this package and the",
                "method it implements."))

bibentry(
  bibtype = "Manual",
  title   = "CORA: Combinational Regularity Analysis",
  author  = person("Young", "Chan"),
  year    = "2026",
  note    = "R package version 0.1.0",
  url     = "https://github.com/youngchanresearcher/CORA"
)

bibentry(
  bibtype = "Article",
  title   = paste("Combinational Regularity Analysis (CORA) - a new method",
                  "for uncovering complex causation in medical and health",
                  "research"),
  author  = c(person("Alrik", "Thiem"),
              person("Lusine", "Mkrtchyan"),
              person("Zuzana", "Sebechlebská")),
  journal = "BMC Medical Research Methodology",
  year    = "2023",
  volume  = "23",
  pages   = "279",
  doi     = "10.1186/s12874-023-02120-2"
)
